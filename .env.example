PINBRIDGE_MCP_PUBLIC_BASE_URL=http://127.0.0.1:57289
PINBRIDGE_MCP_PINBRIDGE_BASE_URL=https://api.pinbridge.io
PINBRIDGE_MCP_PINBRIDGE_API_KEY=
PINBRIDGE_MCP_VERIFY_INCOMING_API_KEYS=true
PINBRIDGE_MCP_AUTH_CACHE_TTL_SECONDS=60
PINBRIDGE_MCP_HOST=127.0.0.1
PINBRIDGE_MCP_PORT=57289
PINBRIDGE_MCP_STREAMABLE_HTTP_PATH=/
PINBRIDGE_MCP_ENABLE_WRITE_TOOLS=false
PINBRIDGE_MCP_LOG_LEVEL=INFO
